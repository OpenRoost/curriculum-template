# EditorConfig is awesome: https://editorconfig.org

# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 119
indent_style = space
indent_size = 2
tab_width = 2

[LICENSE]
max_line_length = 79

[{*.markdown,*.md}]
indent_size = 4
tab_width = 4

[*.schema.json]
max_line_length = unset
