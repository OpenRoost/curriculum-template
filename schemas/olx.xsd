<?xml version="1.0" encoding="UTF-8"?>

<xs:schema
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  elementFormDefault="unqualified"
  attributeFormDefault="unqualified"
  version="0.1.0"
>
  <xs:annotation>
    <xs:documentation>OpenRoost OLX authoring schema. This schema describes the Studio-compatible
      Open Learning XML subset used by OpenRoost course repositories. It is intended for authoring
      assistance and structural validation. The schema is non-normative and does not attempt to
      describe every element, attribute, or XBlock supported by Open edX. Compatibility baseline:
      Open edX Verawood.1.</xs:documentation>
  </xs:annotation>

  <xs:simpleType name="nonemptyString">
    <xs:restriction base="xs:string">
      <xs:minLength value="1" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="gradeFraction">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0" />
      <xs:maxInclusive value="1" />
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="chapterReference">
    <xs:attribute name="url_name" type="nonemptyString" use="required" />
  </xs:complexType>

  <xs:complexType name="courseType">
    <xs:sequence>
      <xs:element
        name="chapter"
        type="chapterReference"
        minOccurs="0"
        maxOccurs="unbounded"
      />
    </xs:sequence>

    <!-- Course identity -->
    <xs:attribute name="url_name" type="nonemptyString" />
    <xs:attribute name="org" type="nonemptyString" />
    <xs:attribute name="course" type="nonemptyString" />

    <!-- Course metadata -->
    <xs:attribute name="display_name" type="nonemptyString" />
    <xs:attribute name="course_image" type="nonemptyString" />
    <xs:attribute name="language" type="xs:language" />

    <!-- Course schedule -->
    <xs:attribute name="start" type="xs:dateTime" />
    <xs:attribute name="end" type="xs:dateTime" />
    <xs:attribute name="enrollment_start" type="xs:dateTime" />
    <xs:attribute name="enrollment_end" type="xs:dateTime" />

    <!-- Course defaults -->
    <xs:attribute name="graceperiod" type="nonemptyString" />
    <xs:attribute name="minimum_grade_credit" type="gradeFraction" />

    <xs:anyAttribute processContents="lax" />
  </xs:complexType>

  <xs:element name="course" type="courseType" />
</xs:schema>
